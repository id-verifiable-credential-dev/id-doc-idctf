        <mxCell id="t162" value="may call, never during a transaction" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#4a5f6f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="34" y="516" width="220" height="20" as="geometry"/></mxCell>
        <mxCell id="c163" value="×" style="rounded=1;arcSize=20;fillColor=#f4f6f8;strokeColor=#cbd5dd;fontSize=12;fontStyle=1;fontColor=#8894a0;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="536" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="t164" value="must not call" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#4a5f6f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="34" y="540" width="220" height="20" as="geometry"/></mxCell>
        <mxCell id="c165" value="✕" style="rounded=1;arcSize=20;fillColor=#f8d7da;strokeColor=#c0392b;fontSize=12;fontStyle=1;fontColor=#a32519;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="560" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="t166" value="must not call, and the pipeline fails the build" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#4a5f6f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="34" y="564" width="220" height="20" as="geometry"/></mxCell>
        <mxCell id="t167" value="Blank cells are calls that never arise. Below the dashed rule, no Module of Trust Infrastructure may call outward." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#4a5f6f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="590" width="220" height="20" as="geometry"/></mxCell>
