# Ask IDCTF, local development. Copy to .env (gitignored) and fill in the key.
# scripts/serve_ask.py reads this file; Vercel reads the same names from the
# project's Environment Variables, never from this file.

# Gemini key from Google AI Studio. Restrict it to the Generative Language API
# and give it a quota and a budget alert before the site goes public.
GEMINI_API_KEY=

# Model aliases. On a free-tier key the lite model answers in 2 to 4 seconds
# while gemini-flash-latest failed every call in the first live run.
ASK_MODEL=gemini-flash-lite-latest
ASK_MODEL_FALLBACK=gemini-flash-latest

# Local port for scripts/serve_ask.py (8000 is often taken by mkdocs serve or Docker).
PORT=8010
