{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.trust.go.id/type-metadata/kartu-asn-v1/schema.json",
  "title": "Kartu ASN",
  "description": "The type claims of id.idctf.kartu-asn.1, in no format's encoding. Illustrative and not registered.",
  "type": "object",
  "properties": {
    "nama": {
      "type": "string",
      "minLength": 1
    },
    "nip": {
      "type": "string",
      "pattern": "^[0-9]{18}$"
    },
    "golongan": {
      "type": "string",
      "minLength": 1
    },
    "status_kepegawaian": {
      "type": "string",
      "enum": [
        "PNS",
        "PPPK"
      ]
    },
    "jabatan": {
      "type": "string",
      "minLength": 1
    },
    "unit_kerja": {
      "type": "string",
      "minLength": 1
    },
    "instansi": {
      "type": "string",
      "minLength": 1
    },
    "foto": {
      "type": "string",
      "contentEncoding": "base64",
      "contentMediaType": "image/jpeg",
      "minLength": 1
    }
  },
  "required": [
    "nama",
    "nip",
    "golongan",
    "status_kepegawaian",
    "jabatan",
    "unit_kerja",
    "instansi",
    "foto"
  ]
}
