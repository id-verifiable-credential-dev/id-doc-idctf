{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.trust.go.id/type-metadata/kartu-nikah-v1/credential-schema.json",
  "title": "Kartu Nikah, W3C VCDM 2.0",
  "description": "The whole ldp_vc credential of id.idctf.kartu-nikah.1. Its credentialSubject takes the type claims from schema.json. Illustrative and not registered.",
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "prefixItems": [
        {
          "const": "https://www.w3.org/ns/credentials/v2"
        },
        {
          "const": "https://catalog.trust.go.id/type-metadata/kartu-nikah-v1/context.jsonld"
        }
      ]
    },
    "type": {
      "type": "array",
      "contains": {
        "const": "KartuNikah"
      }
    },
    "issuer": {
      "type": "string",
      "format": "uri"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:key:"
        }
      },
      "required": [
        "id"
      ],
      "$ref": "https://catalog.trust.go.id/type-metadata/kartu-nikah-v1/schema.json",
      "unevaluatedProperties": false
    },
    "credentialStatus": {
      "type": "array",
      "items": { "type": "object" },
      "minItems": 2,
      "maxItems": 2
    },
    "credentialSchema": {
      "type": "object"
    }
  },
  "required": [
    "@context",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "credentialStatus",
    "credentialSchema"
  ]
}
