{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.trust.go.id/type-metadata/sim-v1/schema.json",
  "title": "org.iso.18013.5.1.mDL.1",
  "type": "object",
  "properties": {
    "family_name": { "type": "string", "maxLength": 150 },
    "given_name": { "type": "string", "maxLength": 150 },
    "birth_date": { "type": "string", "format": "date" },
    "age_over_18": { "type": "boolean" },
    "issue_date": { "type": "string", "format": "date" },
    "expiry_date": { "type": "string", "format": "date" },
    "issuing_country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "issuing_authority": { "type": "string", "maxLength": 150 },
    "document_number": { "type": "string", "maxLength": 25 },
    "driving_privileges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "vehicle_category_code": { "type": "string", "maxLength": 4 },
          "issue_date": { "type": "string", "format": "date" },
          "expiry_date": { "type": "string", "format": "date" }
        },
        "required": ["vehicle_category_code", "issue_date", "expiry_date"]
      }
    },
    "un_distinguishing_sign": { "type": "string", "pattern": "^[A-Z]{1,3}$" },
    "portrait": { "type": "string", "contentEncoding": "base64", "contentMediaType": "image/jpeg" }
  },
  "required": [
    "family_name",
    "given_name",
    "birth_date",
    "age_over_18",
    "issue_date",
    "expiry_date",
    "issuing_country",
    "issuing_authority",
    "document_number",
    "driving_privileges",
    "un_distinguishing_sign",
    "portrait"
  ]
}
